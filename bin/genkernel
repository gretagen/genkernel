#!/usr/bin/env bash

set -euo pipefail

BUILD_DIR="${BUILD_DIR:-/usr/src}"
JOBS="${JOBS:-$(nproc)}"
DRY_RUN=false
LOG_FILE="/var/log/kernel_generation.log"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[INFO]${RESET}  $*" | tee -a "$LOG_FILE"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*" | tee -a "$LOG_FILE"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*" | tee -a "$LOG_FILE"; }
error()   { echo -e "${RED}[ERROR]${RESET} $*" | tee -a "$LOG_FILE"; exit 1; }
step()    { echo -e "\n${BOLD}══ $* ${RESET}" | tee -a "$LOG_FILE"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --jobs=*) JOBS="${1#*=}"; shift ;;
    --jobs)
      [[ -n "${2:-}" ]] || error "--jobs requires a value."
      JOBS="$2"; shift 2
      ;;
    -h|--help)
      echo "Usage: genkernel [--dry-run] [--jobs N]"
      exit 0
      ;;
    *) error "Unknown option: $1" ;;
  esac
done

if [ "$EUID" -ne 0 ]; then
    echo "Generating a kernel requires superuser privileges."
    exit 1
fi

mkdir -p "$(dirname "$LOG_FILE")"
echo "=== Kernel generation started $(date) ===" >> "$LOG_FILE"

info "Genkernel : Custom kernels, made easy."


step "Fetching latest kernel versions"

RAW=$(curl -fsSL "https://www.kernel.org/releases.json") \
  || error "Could not fetch kernel versions from kernel.org."

# kernel.org pretty-prints releases.json, so the indentation of each line says
# which object it belongs to. That matters: several values are unquoted JSON
# scalars (null), which a naive quote-split parser mis-reads as the *next* key.
PARSED=$(printf '%s\n' "$RAW" | awk '
  /^        \{/          { moniker=""; version=""; source=""; pgp=""; next }
  /^        \},?[ \t]*$/ { if (version != "") print moniker "\t" version "\t" source "\t" pgp; next }
  {
    line = $0
    if (line ~ /^            "moniker": *"/) { sub(/^ *"moniker": *"/, "", line); sub(/",? *$/, "", line); moniker = line; next }
    if (line ~ /^            "version": *"/) { sub(/^ *"version": *"/, "", line); sub(/",? *$/, "", line); version = line; next }
    if (line ~ /^            "source":/)    { sub(/^ *"source": */, "", line); sub(/,? *$/, "", line); gsub(/"/, "", line); source = line; next }
    if (line ~ /^            "pgp":/)       { sub(/^ *"pgp": */, "", line); sub(/,? *$/, "", line); gsub(/"/, "", line); pgp = line; next }
  }
')

declare -a MONIKERS=()
declare -a VERSIONS=()
declare -a SOURCES=()
declare -a PGPS=()
while IFS=$'\t' read -r moniker version source pgp; do
  # linux-next carries no prepared source tarball, so it is not offered.
  if [[ "$source" == "null" || -z "$source" ]]; then
    continue
  fi
  MONIKERS+=("$moniker")
  VERSIONS+=("$version")
  SOURCES+=("$source")
  PGPS+=("$pgp")
done <<< "$PARSED"

[[ ${#VERSIONS[@]} -eq 0 ]] && error "Failed to parse kernel versions from kernel.org."

CURRENT=$(uname -r)
echo "System running on kernel $CURRENT"

echo ""
echo -e "${BOLD}Available kernel versions:${RESET}"
echo ""

i=1
for idx in "${!VERSIONS[@]}"; do
  printf "  ${CYAN}%d)${RESET} %-12s (%s)\n" "$i" "${VERSIONS[$idx]}" "${MONIKERS[$idx]}"
  i=$((i+1))
done

echo ""
read -rp "Select version to build [1]: " choice
choice=${choice:-1}

if [[ ! "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#VERSIONS[@]} )); then
  error "Invalid selection: $choice"
fi

# The menu is 1-based; the arrays are 0-based.
IDX=$(( choice - 1 ))

echo ""
info "Will generate: ${VERSIONS[$IDX]}"
warn "Generating a kernel will change your current one."
read -rp "Proceed? [y/N]: " confirm

case "$confirm" in
  y|Y|yes|YES) ;;
  *) echo "Cancelled."; exit 0 ;;
esac

$DRY_RUN && { info "--dry-run: exiting without making changes."; exit 0; }

LATEST="${VERSIONS[$IDX]}"
DOWNLOAD_URL="${SOURCES[$IDX]}"
PGP_URL="${PGPS[$IDX]}"

# Artifact names come from the URLs: mainline ships as a .tar.gz from
# git.kernel.org, stable/longterm as a .tar.xz from cdn.kernel.org.
TARBALL="${DOWNLOAD_URL##*/}"
SIGNED=false
SIGNATURE=""
if [[ "$PGP_URL" != "null" && -n "$PGP_URL" ]]; then
  SIGNATURE="${PGP_URL##*/}"
  SIGNED=true
fi

# Kernel tarballs unpack into a "linux-<version>" directory.
SRC_NAME="linux-$LATEST"
SRC_DIR="$BUILD_DIR/$SRC_NAME"

# Prints the top-level directory of an archive, e.g. "linux-6.18.54", and
# fails if the archive is not a readable, complete tarball. The whole listing
# is drained on purpose: that is what makes a truncated download fail here
# instead of half way through extraction.
archive_probe() {
  local first
  first=$(tar -tf "$1" 2>/dev/null | {
    IFS= read -r line
    cat >/dev/null
    printf '%s' "$line"
  }) || return 1
  printf '%s' "${first%%/*}"
}

# A cached tarball is only reusable if it is intact and really unpacks into
# the expected source directory. Anything else (truncated, HTML error page,
# leftover from a different version) is thrown away and fetched again.
tarball_matches() {
  local top
  top=$(archive_probe "$1") || return 1
  [[ -n "$top" && "$top" == "$2" ]]
}

cd "$BUILD_DIR" || error "Cannot enter $BUILD_DIR."

if tarball_matches "$TARBALL" "$SRC_NAME"; then
  info "Tarball already present and valid — skipping download."
else
  if [[ -e "$TARBALL" ]]; then
    warn "Cached $TARBALL is not a usable $SRC_NAME archive — removing it."
    rm -f "$TARBALL"
  fi
  info "Downloading from $DOWNLOAD_URL"
  curl -L --progress-bar -o "$TARBALL" "$DOWNLOAD_URL" \
    || { rm -f "$TARBALL"; error "Download failed."; }
  tarball_matches "$TARBALL" "$SRC_NAME" \
    || { rm -f "$TARBALL"; error "Downloaded file is not a valid $SRC_NAME tarball."; }
fi

# GPG signature verification
if $SIGNED; then
  info "Downloading GPG signature..."
  curl -L -fsS -o "$SIGNATURE" "$PGP_URL" \
    || { rm -f "$SIGNATURE"; error "Could not download signature."; }

  # Work out which key signed the tarball and fetch it when we are missing it.
  # kernel.org no longer serves a keys page, so this goes via a keyserver.
  KEYID=$(gpg --list-packets "$SIGNATURE" 2>/dev/null | awk '/keyid/ {print $NF; exit}') || true
  if [[ -n "$KEYID" ]] && ! gpg --list-keys "$KEYID" >/dev/null 2>&1; then
    info "Importing signing key $KEYID from keyserver..."
    curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x$KEYID" \
      | gpg --import 2>&1 | tee -a "$LOG_FILE" \
      || warn "Could not import signing key — verification will probably fail."
  fi

  info "Verifying GPG signature..."
  if gpg --verify "$SIGNATURE" "$TARBALL" 2>&1 | tee -a "$LOG_FILE"; then
    success "Signature OK."
  else
    warn "GPG verification failed — continuing anyway. See $LOG_FILE for details."
  fi
else
  info "No detached signature published for $LATEST — skipping verification."
fi

step "Extracting $SRC_DIR"

if [[ -d "$SRC_DIR" ]]; then
  info "Source directory already exists — skipping extraction."
else
  info "Extracting (this may take a minute)..."
  tar -xf "$TARBALL" -C "$BUILD_DIR" || error "Extraction failed."
  [[ -d "$SRC_DIR" ]] \
    || error "Archive did not produce $SRC_DIR (top level: $(archive_probe "$TARBALL"))."
fi
success "Source ready at $SRC_DIR"

step "Configure kernel"
cd "$SRC_DIR" || error "Cannot enter $SRC_DIR."

RUNNING_CONFIG="/boot/config-${CURRENT}"
if [[ -f "$RUNNING_CONFIG" ]]; then
  info "Basing config on running kernel: $RUNNING_CONFIG"
  cp "$RUNNING_CONFIG" .config
  make olddefconfig
else
  info "No existing config found — using defconfig as base."
  make defconfig
fi

echo ""
echo -e "${BOLD}Kernel configuration:${RESET}"
echo "  1) skip — keep current config as-is"
echo "  2) menuconfig — interactive ncurses menu"
echo "  3) tinyconfig — minimal configuration"
echo ""
read -rp "Choice [1/2/3]: " config_choice

case "$config_choice" in
  2)
    make menuconfig
    ;;
  3)
    make tinyconfig
    ;;
  *)
    info "Keeping config unchanged."
    ;;
esac

# Apply Haliade OS defaults: disable signing, set localversion
scripts/config --disable MODULE_SIG_ALL 2>/dev/null || true
scripts/config --disable SYSTEM_TRUSTED_KEYS 2>/dev/null || true
scripts/config --set-str SYSTEM_TRUSTED_KEYS "" 2>/dev/null || true
scripts/config --disable SYSTEM_REVOCATION_KEYS 2>/dev/null || true
scripts/config --set-str SYSTEM_REVOCATION_KEYS "" 2>/dev/null || true
scripts/config --set-str CONFIG_LOCALVERSION "-gen" 2>/dev/null || true
# Ensure critical filesystems are built-in
scripts/config --enable CONFIG_BTRFS_FS 2>/dev/null || true
scripts/config --enable CONFIG_OVERLAY_FS 2>/dev/null || true

# scripts/config edits .config directly, so re-run the config machinery to
# resolve anything it added or invalidated.
make olddefconfig 2>&1 | tee -a "$LOG_FILE" >/dev/null \
  || error "Kernel configuration refresh failed."

success "Kernel configured."

# Pick up the final version string
NEW_VERSION=$(make -s kernelrelease 2>/dev/null)
info "New kernel version: $NEW_VERSION"

step "Compiling kernel (using $JOBS jobs)"
START_TIME=$SECONDS

make -j"$JOBS" 2>&1 | tee -a "$LOG_FILE" || error "Compilation failed. Check $LOG_FILE"

ELAPSED=$(( SECONDS - START_TIME ))
success "Compiled in $(( ELAPSED / 60 ))m $(( ELAPSED % 60 ))s"

step "Installing modules"
make modules_install 2>&1 | tee -a "$LOG_FILE" || error "Module install failed."

if [[ ! -d "/lib/modules/$NEW_VERSION" ]]; then
  error "Module directory /lib/modules/$NEW_VERSION was not created"
fi

step "Installing kernel image to /boot"
cp -v arch/x86/boot/bzImage /boot/vmlinuz-"$NEW_VERSION" \
  || error "Failed to copy kernel image to /boot"
cp -v System.map /boot/System.map-"$NEW_VERSION" 2>/dev/null || true
cp -v .config /boot/config-"$NEW_VERSION" 2>/dev/null || true

step "Installing initramfs"
INITRAMFS_SRC=""
INITRAMFS_DEST="/boot/initramfs-${NEW_VERSION}.img"

# Try distro-specific initramfs generators first
if command -v mkinitcpio &>/dev/null; then
  mkinitcpio -k "$NEW_VERSION" -g "$INITRAMFS_DEST" \
    || error "initramfs generation failed for $NEW_VERSION"
elif command -v dracut &>/dev/null; then
  dracut --force "$INITRAMFS_DEST" "$NEW_VERSION" \
    || error "initramfs generation failed for $NEW_VERSION"
elif command -v update-initramfs &>/dev/null; then
  update-initramfs -u -k "$NEW_VERSION" \
    || error "initramfs generation failed for $NEW_VERSION"
elif command -v kernel-install &>/dev/null; then
  kernel-install add "$NEW_VERSION" /boot/vmlinuz-"$NEW_VERSION"
elif [[ -d /tmp/initramfs_extract ]]; then
  # Custom minimal initramfs rebuild (Haliade OS style)
  info "Rebuilding initramfs from /tmp/initramfs_extract..."
  cd /tmp/initramfs_extract
  find . | cpio -o -H newc | gzip > "$INITRAMFS_DEST" \
    || error "initramfs rebuild failed."
elif [[ -f /boot/initramfs-${CURRENT}.img ]]; then
  info "Copying current initramfs (kernel-agnostic)..."
  cp /boot/initramfs-${CURRENT}.img "$INITRAMFS_DEST"
else
  warn "No initramfs generator or source found — kernel may not boot without one."
fi

step "Updating bootloader"

# Limine detection/update
if [[ -f /boot/limine.conf ]]; then
  info "Detected Limine bootloader — updating /boot/limine.conf..."
  LIMINE_CFG="/boot/limine.conf"
  cp "$LIMINE_CFG" "${LIMINE_CFG}.bak"
  info "Backed up to ${LIMINE_CFG}.bak"

  # Update kernel path
  sed -i "s|kernel_path: boot():/vmlinuz-[^ ]*|kernel_path: boot():/vmlinuz-${NEW_VERSION}|g" "$LIMINE_CFG"
  # Update initramfs path
  sed -i "s|module_path: boot():/initramfs-[^ ]*\.img|module_path: boot():/initramfs-${NEW_VERSION}.img|g" "$LIMINE_CFG"
  success "Limine config updated for kernel $NEW_VERSION."
fi

# GRUB detection/update (fallback for non-Haliade distros)
if command -v grub-mkconfig &>/dev/null || command -v update-grub &>/dev/null; then
  GRUB_CMD=""
  if command -v grub-mkconfig &>/dev/null; then
    GRUB_CMD="grub-mkconfig"
  elif command -v update-grub &>/dev/null; then
    GRUB_CMD="update-grub"
  fi

  GRUB_CFG=""
  for p in /boot/grub/grub.cfg /boot/efi/EFI/GRUB/grub.cfg; do
    [[ -f "$p" ]] && { GRUB_CFG="$p"; break; }
  done
  [[ -z "$GRUB_CFG" ]] && GRUB_CFG="/boot/grub/grub.cfg"

  cp "$GRUB_CFG" "${GRUB_CFG}.bak"
  info "Backed up grub.cfg to ${GRUB_CFG}.bak"

  if [[ "$GRUB_CMD" == "update-grub" ]]; then
    $GRUB_CMD 2>&1 | tee -a "$LOG_FILE" || error "update-grub failed."
  else
    $GRUB_CMD -o "$GRUB_CFG" 2>&1 | tee -a "$LOG_FILE" || error "grub-mkconfig failed."
  fi
  success "GRUB config regenerated with Linux $NEW_VERSION entry."
fi

step "Cleaning up"
cd "$BUILD_DIR" 2>/dev/null || true
rm -rf "$SRC_DIR" 2>/dev/null || warn "Could not remove $SRC_DIR"
rm -f "$BUILD_DIR/$TARBALL" 2>/dev/null || true
if $SIGNED; then
  rm -f "$BUILD_DIR/$SIGNATURE" 2>/dev/null || true
fi

echo ""
echo -e "${GREEN}${BOLD}╔══════════════════════════════════════════════════════╗${RESET}"
echo -e "${GREEN}${BOLD}║  Kernel $NEW_VERSION generated successfully.  ║${RESET}"
echo -e "${GREEN}${BOLD}╠══════════════════════════════════════════════════════╣${RESET}"
echo -e "${GREEN}${BOLD}║  Requiring reboot to use this kernel                 ║${RESET}"
echo -e "${GREEN}${BOLD}║    ${BOLD}reboot                                            ║${RESET}"
echo -e "${GREEN}${BOLD}╚══════════════════════════════════════════════════════╝${RESET}"
echo ""
info "Full log saved to $LOG_FILE"
