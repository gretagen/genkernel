#!/usr/bin/env bash

set -euo pipefail

BUILD_DIR="${BUILD_DIR:-/usr/src}"
JOBS="${JOBS:-$(nproc)}"
DRY_RUN=false
LOG_FILE="/var/log/kernel_generation.log"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[INFO]${RESET}  $*" | tee -a "$LOG_FILE"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*" | tee -a "$LOG_FILE"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*" | tee -a "$LOG_FILE"; }
error()   { echo -e "${RED}[ERROR]${RESET} $*" | tee -a "$LOG_FILE"; exit 1; }
step()    { echo -e "\n${BOLD}══ $* ${RESET}" | tee -a "$LOG_FILE"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --jobs=*) JOBS="${1#*=}"; shift ;;
    --jobs)
      [[ -n "${2:-}" ]] || error "--jobs requires a value."
      JOBS="$2"; shift 2
      ;;
    -h|--help)
      echo "genkernel | custom kernel builder for the Haliade system"
      echo
      echo "Usage: genkernel [--dry-run] [--jobs N]"
      exit 0
      ;;
    *) error "Unknown option: $1" ;;
  esac
done

if [ "$EUID" -ne 0 ]; then
    echo "Generating a kernel requires superuser privileges."
    exit 1
fi

mkdir -p "$(dirname "$LOG_FILE")"
echo "=== Kernel generation started $(date) ===" >> "$LOG_FILE"

info "Genkernel: Custom kernels, made easy."


step "Fetching latest kernel versions"

RAW=$(curl -fsSL "https://www.kernel.org/releases.json") \
  || error "Could not fetch kernel versions from kernel.org."

# kernel.org pretty-prints releases.json, so the indentation of each line says
# which object it belongs to. That matters: several values are unquoted JSON
# scalars (null), which a naive quote-split parser mis-reads as the *next* key.
PARSED=$(printf '%s\n' "$RAW" | awk '
  /^        \{/          { moniker=""; version=""; source=""; pgp=""; next }
  /^        \},?[ \t]*$/ { if (version != "") print moniker "\t" version "\t" source "\t" pgp; next }
  {
    line = $0
    if (line ~ /^            "moniker": *"/) { sub(/^ *"moniker": *"/, "", line); sub(/",? *$/, "", line); moniker = line; next }
    if (line ~ /^            "version": *"/) { sub(/^ *"version": *"/, "", line); sub(/",? *$/, "", line); version = line; next }
    if (line ~ /^            "source":/)    { sub(/^ *"source": */, "", line); sub(/,? *$/, "", line); gsub(/"/, "", line); source = line; next }
    if (line ~ /^            "pgp":/)       { sub(/^ *"pgp": */, "", line); sub(/,? *$/, "", line); gsub(/"/, "", line); pgp = line; next }
  }
')

declare -a MONIKERS=()
declare -a VERSIONS=()
declare -a SOURCES=()
declare -a PGPS=()
while IFS=$'\t' read -r moniker version source pgp; do
  # linux-next carries no prepared source tarball, so it is not offered.
  if [[ "$source" == "null" || -z "$source" ]]; then
    continue
  fi
  MONIKERS+=("$moniker")
  VERSIONS+=("$version")
  SOURCES+=("$source")
  PGPS+=("$pgp")
done <<< "$PARSED"

[[ ${#VERSIONS[@]} -eq 0 ]] && error "Failed to parse kernel versions from kernel.org."

CURRENT=$(uname -r)
echo "System running on kernel $CURRENT"

echo ""
echo -e "${BOLD}Available kernel versions:${RESET}"
echo ""

i=1
for idx in "${!VERSIONS[@]}"; do
  printf "  ${CYAN}%d)${RESET} %-12s (%s)\n" "$i" "${VERSIONS[$idx]}" "${MONIKERS[$idx]}"
  i=$((i+1))
done

echo ""
read -rp "Select version to build [1]: " choice
choice=${choice:-1}

if [[ ! "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#VERSIONS[@]} )); then
  error "Invalid selection: $choice"
fi

# The menu is 1-based; the arrays are 0-based.
IDX=$(( choice - 1 ))

echo ""
info "Will generate: ${VERSIONS[$IDX]}"
warn "Generating a kernel will change your current one."
read -rp "Proceed? [y/N]: " confirm


case "$confirm" in
  y|Y|yes|YES) ;;
  *) echo "Cancelled."; exit 0 ;;
esac

$DRY_RUN && { info "--dry-run: exiting without making changes."; exit 0; }

LATEST="${VERSIONS[$IDX]}"
DOWNLOAD_URL="${SOURCES[$IDX]}"
PGP_URL="${PGPS[$IDX]}"

# Artifact names come from the URLs: mainline ships as a .tar.gz from
# git.kernel.org, stable/longterm as a .tar.xz from cdn.kernel.org.
TARBALL="${DOWNLOAD_URL##*/}"
SIGNED=false
SIGNATURE=""
if [[ "$PGP_URL" != "null" && -n "$PGP_URL" ]]; then
  SIGNATURE="${PGP_URL##*/}"
  SIGNED=true
fi

# Kernel tarballs unpack into a "linux-<version>" directory.
SRC_NAME="linux-$LATEST"
SRC_DIR="$BUILD_DIR/$SRC_NAME"

# Prints the top-level directory of an archive, e.g. "linux-6.18.54", and
# fails if the archive is not a readable, complete tarball. The whole listing
# is drained on purpose: that is what makes a truncated download fail here
# instead of half way through extraction.
archive_probe() {
  local first
  first=$(tar -tf "$1" 2>/dev/null | {
    IFS= read -r line
    cat >/dev/null
    printf '%s' "$line"
  }) || return 1
  printf '%s' "${first%%/*}"
}

# A cached tarball is only reusable if it is intact and really unpacks into
# the expected source directory. Anything else (truncated, HTML error page,
# leftover from a different version) is thrown away and fetched again.
tarball_matches() {
  local top
  top=$(archive_probe "$1") || return 1
  [[ -n "$top" && "$top" == "$2" ]]
}

cd "$BUILD_DIR" || error "Cannot enter $BUILD_DIR."

if tarball_matches "$TARBALL" "$SRC_NAME"; then
  info "Tarball already present and valid, skipping download."
else
  if [[ -e "$TARBALL" ]]; then
    warn "Cached $TARBALL is not a usable $SRC_NAME archive, removing it."
    rm -f "$TARBALL"
  fi
  info "Downloading from $DOWNLOAD_URL"
  curl -L --progress-bar -o "$TARBALL" "$DOWNLOAD_URL" \
    || { rm -f "$TARBALL"; error "Download failed."; }
  tarball_matches "$TARBALL" "$SRC_NAME" \
    || { rm -f "$TARBALL"; error "Downloaded file is not a valid $SRC_NAME tarball."; }
fi

# GPG signature verification
if $SIGNED; then
  info "Downloading GPG signature..."
  curl -L -fsS -o "$SIGNATURE" "$PGP_URL" \
    || { rm -f "$SIGNATURE"; error "Could not download signature."; }

  # Work out which key signed the tarball and fetch it when we are missing it.
  # kernel.org no longer serves a keys page, so this goes via a keyserver.
  KEYID=$(gpg --list-packets "$SIGNATURE" 2>/dev/null | awk '/keyid/ {print $NF; exit}') || true
  if [[ -n "$KEYID" ]] && ! gpg --list-keys "$KEYID" >/dev/null 2>&1; then
    info "Importing signing key $KEYID from keyserver..."
    curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x$KEYID" \
      | gpg --import 2>&1 | tee -a "$LOG_FILE" \
      || warn "Could not import signing key: verification will probably fail."
  fi

  info "Verifying GPG signature..."
  if gpg --verify "$SIGNATURE" "$TARBALL" 2>&1 | tee -a "$LOG_FILE"; then
    success "Signature OK."
  else
    warn "GPG verification failed: continuing anyway. See $LOG_FILE for details."
  fi
else
  info "No detached signature published for $LATEST, skipping verification."
fi

step "Extracting $SRC_DIR"

if [[ -d "$SRC_DIR" ]]; then
  info "Source directory already exists, skipping extraction."
else
  info "Extracting (this may take a minute)..."
  tar -xf "$TARBALL" -C "$BUILD_DIR" || error "Extraction failed."
  [[ -d "$SRC_DIR" ]] \
    || error "Archive did not produce $SRC_DIR (top level: $(archive_probe "$TARBALL"))."
fi
success "Source ready at $SRC_DIR"

step "Configure kernel"
cd "$SRC_DIR" || error "Cannot enter $SRC_DIR."

RUNNING_CONFIG="/boot/config-${CURRENT}"
# Inside a chroot of the target rootfs, uname -r (and thus $CURRENT) reports
# the *host* kernel, whose config is not in the tree: fall back to the
# newest config present so the target's own configuration is preserved
# instead of silently starting over from defconfig.
if [[ ! -f "$RUNNING_CONFIG" ]]; then
  RUNNING_CONFIG=$(ls -t /boot/config-* 2>/dev/null | head -1 || true)
fi
if [[ -n "$RUNNING_CONFIG" && -f "$RUNNING_CONFIG" ]]; then
  info "Basing config on running kernel: $RUNNING_CONFIG"
  cp "$RUNNING_CONFIG" .config
  make olddefconfig
else
  info "No existing config found: using defconfig as base."
  make defconfig
fi

echo ""
echo -e "${BOLD}Kernel configuration:${RESET}"
echo "  1) skip: keep current config as-is"
echo "  2) menuconfig: interactive ncurses menu"
echo "  3) tinyconfig: minimal configuration"
echo ""
read -rp "Choice [1/2/3]: " config_choice

case "$config_choice" in
  2)
    make menuconfig
    ;;
  3)
    make tinyconfig
    ;;
  *)
    info "Keeping config unchanged."
    ;;
esac

# Apply Haliade system defaults: disable signing, set localversion
scripts/config --disable MODULE_SIG_ALL 2>/dev/null || true
scripts/config --disable SYSTEM_TRUSTED_KEYS 2>/dev/null || true
scripts/config --set-str SYSTEM_TRUSTED_KEYS "" 2>/dev/null || true
scripts/config --disable SYSTEM_REVOCATION_KEYS 2>/dev/null || true
scripts/config --set-str SYSTEM_REVOCATION_KEYS "" 2>/dev/null || true
scripts/config --set-str CONFIG_LOCALVERSION "-gen" 2>/dev/null || true
# Ensure critical filesystems are built-in
scripts/config --enable CONFIG_BTRFS_FS 2>/dev/null || true
scripts/config --enable CONFIG_OVERLAY_FS 2>/dev/null || true
# GPU display drivers built-in so every TTY renders on every connected
# display from the earliest boot stage (matches amdgpu/i915 above)
scripts/config --enable CONFIG_DRM_NOUVEAU 2>/dev/null || true

# Complete audio + microphone support (persistent defaults)
# Critical audio/mic drivers are built-in (=y); the long tail is modules (=m).
# --keep-case matters: scripts/config upper-cases symbol names by default and
# sound has mixed-case symbols (e.g. SND_SOC_AMD_ACP3x).
AUDIO_CRITICAL=(
  SND_OSSEMUL SND_MIXER_OSS SND_PCM_OSS SND_CTL_INPUT_VALIDATION SND_UTIMER SND_SEQ_UMP
  SND_PCSP SND_DUMMY SND_ALOOP SND_VIRMIDI SND_PCMTEST
  SND_HDA_RECONFIG SND_HDA_INPUT_BEEP SND_HDA_PATCH_LOADER SND_HDA_CTL_DEV_ID
  SND_HDA_ACPI SND_HDA_INTEL_HDMI_SILENT_STREAM
  SND_HDA_CODEC_ANALOG SND_HDA_CODEC_SIGMATEL SND_HDA_CODEC_VIA SND_HDA_CODEC_CONEXANT
  SND_HDA_CODEC_SENARYTECH SND_HDA_CODEC_CA0110 SND_HDA_CODEC_CA0132 SND_HDA_CODEC_CMEDIA
  SND_HDA_CODEC_CM9825 SND_HDA_CODEC_SI3054 SND_HDA_CODEC_CIRRUS
  SND_HDA_SCODEC_CS35L41_I2C SND_HDA_SCODEC_CS35L56_I2C SND_HDA_SCODEC_TAS2781_I2C
  SND_USB_AUDIO
  SOUNDWIRE SND_SOC_SOF_ACPI SND_SOC_DMIC SND_SOC_AC97_CODEC SND_SOC_HDA SND_SOC_BT_SCO
  SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH SND_SOC_INTEL_AVS SND_SOC_INTEL_CATPT
  SND_SST_ATOM_HIFI2_PLATFORM_PCI
  SND_SOC_AMD_ACP_COMMON SND_SOC_AMD_ACP3x SND_SOC_AMD_ACP5x SND_SOC_AMD_ACP6x
  SND_SOC_AMD_RENOIR SND_SOC_AMD_RPL_ACP6x SND_SOC_AMD_PS SND_SOC_SOF_AMD_TOPLEVEL
  SND_SOC_SIMPLE_CARD SND_VIRTIO
)
for _audiosym in "${AUDIO_CRITICAL[@]}"; do
  scripts/config --keep-case --enable "$_audiosym" 2>/dev/null || true
done

# Long tail: every other disabled audio symbol becomes a module, except the
# non-x86 embedded platforms and SND_DEBUG (see AUDIO_EXCLUDE).
AUDIO_EXCLUDE="^(SND_DEBUG|SND_SOC_FSL_|SND_SOC_IMX_|SND_SOC_XILINX_|SND_SOC_XTFPGA_|SND_SOC_MTK_|SND_SOC_MT6351|SND_SOC_MT6357|SND_SOC_MT6358|SND_SOC_MT6660|SND_SOC_MSM8916|SND_SOC_LPASS_|SND_BCM63XX|SND_SOC_ADI_AXI_|SND_SOC_STI|SND_SOC_CHV3|SND_I2S_HI6210|SND_DESIGNWARE_I2S|SND_SOC_TSCS42XX|SND_SOC_TSCS454)"
for _audiosym in "${AUDIO_CRITICAL[@]}"; do
  AUDIO_EXCLUDE="$AUDIO_EXCLUDE|^${_audiosym}$"
done
mapfile -t AUDIO_TAIL < <(grep -E "^# CONFIG_(SND|SOUND)[A-Z0-9_]* is not set" .config 2>/dev/null \
  | sed -E "s/^# CONFIG_([A-Z0-9_]+) is not set/\1/" \
  | grep -vE "$AUDIO_EXCLUDE" || true)
for _audiosym in "${AUDIO_TAIL[@]}"; do
  scripts/config --keep-case --module "$_audiosym" 2>/dev/null || true
done

# Buses that unlock more codecs (SPI + FireWire pro-audio) and the Intel
# LPSS MFD plus regmap-SPI needed by SPI-attached and LPSS machine drivers.
scripts/config --keep-case --enable SPI 2>/dev/null || true
scripts/config --keep-case --enable SPI_MASTER 2>/dev/null || true
scripts/config --keep-case --enable REGMAP_SPI 2>/dev/null || true
scripts/config --keep-case --enable MFD_INTEL_LPSS 2>/dev/null || true
scripts/config --keep-case --enable FIREWIRE 2>/dev/null || true
scripts/config --keep-case --enable FIREWIRE_OHCI 2>/dev/null || true
for _audiosym in SND_FIREWIRE SND_FIREWIRE_LIB SND_DICE SND_FIREWORKS SND_BEBOB SND_OXFW \
                 SND_ISIGHT SND_SCS1X SND_FIREWIRE_DIGI00X SND_FIREWIRE_TASCAM SND_FIREWIRE_MOTU; do
  scripts/config --keep-case --module "$_audiosym" 2>/dev/null || true
done

# scripts/config edits .config directly, so re-run the config machinery to
# resolve anything it added or invalidated.
make olddefconfig 2>&1 | tee -a "$LOG_FILE" >/dev/null \
  || error "Kernel configuration refresh failed."

# Audio convergence pass: enable anything still off - bool selectors and
# hidden children that the pass above + olddefconfig revealed (SoundWire
# codecs, SOF/ACPI machine drivers, AMD/LPSS boards, ...). Iterate until the
# number of disabled audio symbols stops changing; each pass is idempotent.
AUDIO_EXCLUDE_B="^(SND_DEBUG|SND_SOC_FSL_|SND_SOC_IMX_|SND_SOC_XILINX_|SND_SOC_XTFPGA_|SND_SOC_MTK_|SND_SOC_MT6351|SND_SOC_MT6357|SND_SOC_MT6358|SND_SOC_MT6660|SND_SOC_MSM8916|SND_SOC_LPASS_|SND_BCM63XX|SND_SOC_ADI_AXI_|SND_SOC_STI|SND_SOC_CHV3|SND_I2S_HI6210|SND_DESIGNWARE_I2S|SND_SOC_TSCS42XX|SND_SOC_TSCS454)"
haliade_audio_remain() {
  local _audiosym
  while IFS= read -r _audiosym; do
    scripts/config --keep-case --enable "$_audiosym" 2>/dev/null || true
  done < <(grep -E "^# CONFIG_(SND|SOUND)[A-Z0-9_]* is not set" .config 2>/dev/null \
    | sed -E "s/^# CONFIG_([A-Z0-9_]+) is not set/\1/" \
    | grep -vE "$AUDIO_EXCLUDE_B" || true)
}
for _audioiter in 1 2 3 4 5 6 7 8; do
  _audiobefore=$(grep -cE "^# CONFIG_(SND|SOUND)[A-Z0-9_]* is not set" .config 2>/dev/null || echo 0)
  haliade_audio_remain
  make olddefconfig 2>&1 | tee -a "$LOG_FILE" >/dev/null || true
  _audioafter=$(grep -cE "^# CONFIG_(SND|SOUND)[A-Z0-9_]* is not set" .config 2>/dev/null || echo 0)
  [[ "$_audiobefore" == "$_audioafter" ]] && break
done

success "Kernel configured."

# Pick up the final version string
NEW_VERSION=$(make -s kernelrelease 2>/dev/null)
info "New kernel version: $NEW_VERSION"

step "Compiling kernel (using $JOBS jobs)"
START_TIME=$SECONDS

make -j"$JOBS" 2>&1 | tee -a "$LOG_FILE" || error "Compilation failed. Check $LOG_FILE"

ELAPSED=$(( SECONDS - START_TIME ))
success "Compiled in $(( ELAPSED / 60 ))m $(( ELAPSED % 60 ))s"

step "Installing modules"
make modules_install 2>&1 | tee -a "$LOG_FILE" || error "Module install failed."

if [[ ! -d "/lib/modules/$NEW_VERSION" ]]; then
  error "Module directory /lib/modules/$NEW_VERSION was not created"
fi

step "Installing kernel image to /boot"
cp -v arch/x86/boot/bzImage /boot/vmlinuz-"$NEW_VERSION" \
  || error "Failed to copy kernel image to /boot"
cp -v System.map /boot/System.map-"$NEW_VERSION" 2>/dev/null || true
cp -v .config /boot/config-"$NEW_VERSION" 2>/dev/null || true

step "Installing initramfs"
INITRAMFS_DEST="/boot/initramfs-${NEW_VERSION}.img"

[[ -d /boot ]] || error "/boot does not exist: cannot install $INITRAMFS_DEST."

# Generators that take an explicit output path validate it before doing any
# work, and mkinitcpio's check only tests -w on the target file when that file
# already exists; it never falls back to the parent directory. A stale image
# left behind by an earlier run therefore aborts generation even though /boot
# itself is perfectly writable. Generate under a name that does not exist yet,
# then move it into place, which also replaces the stale file atomically
# (same filesystem). Deliberately not /tmp: these images are hundreds of
# megabytes and /tmp is usually a tmpfs.
INITRAMFS_TMP="/boot/.initramfs-${NEW_VERSION}.tmp.img"

# Probe /boot by actually creating a file. [[ -w /boot ]] is not good enough
# here: as root, access(2) reports success even on a read-only mount, so it
# would wave through the exact failure it is meant to catch.
rm -f "$INITRAMFS_TMP"
: > "$INITRAMFS_TMP" 2>/dev/null \
  || error "/boot is not writable (cannot create $INITRAMFS_TMP): remount it read-write and retry."
rm -f "$INITRAMFS_TMP"

# Try distro-specific initramfs generators first
if command -v mkinitcpio &>/dev/null; then
  mkinitcpio -k "$NEW_VERSION" -g "$INITRAMFS_TMP" \
    || { rm -f "$INITRAMFS_TMP"; error "initramfs generation failed for $NEW_VERSION"; }
elif command -v dracut &>/dev/null; then
  dracut --force "$INITRAMFS_TMP" "$NEW_VERSION" \
    || { rm -f "$INITRAMFS_TMP"; error "initramfs generation failed for $NEW_VERSION"; }
elif command -v update-initramfs &>/dev/null; then
  # update-initramfs chooses its own output name (/boot/initrd.img-$ver), so
  # there is nothing to redirect here.
  update-initramfs -u -k "$NEW_VERSION" \
    || error "initramfs generation failed for $NEW_VERSION"
elif command -v kernel-install &>/dev/null; then
  # Likewise: kernel-install owns the naming.
  kernel-install add "$NEW_VERSION" /boot/vmlinuz-"$NEW_VERSION" \
    || error "initramfs generation failed for $NEW_VERSION"
elif [[ -d /tmp/initramfs_extract ]]; then
  # Custom minimal initramfs rebuild (Haliade system style)
  info "Rebuilding initramfs from /tmp/initramfs_extract..."
  ( cd /tmp/initramfs_extract && find . | cpio -o -H newc | gzip ) > "$INITRAMFS_TMP" \
    || { rm -f "$INITRAMFS_TMP"; error "initramfs rebuild failed."; }
elif [[ -f /boot/initramfs-${CURRENT}.img ]]; then
  info "Copying current initramfs (kernel-agnostic)..."
  cp /boot/initramfs-${CURRENT}.img "$INITRAMFS_TMP" \
    || { rm -f "$INITRAMFS_TMP"; error "Could not copy the current initramfs."; }
fi

# Install whatever the generator produced, replacing any stale image.
if [[ -e "$INITRAMFS_TMP" ]]; then
  mv -f "$INITRAMFS_TMP" "$INITRAMFS_DEST" \
    || error "Could not install $INITRAMFS_DEST"
fi

if [[ -e "$INITRAMFS_DEST" ]]; then
  [[ -s "$INITRAMFS_DEST" ]] \
    || error "$INITRAMFS_DEST is empty: no usable initramfs was produced."
  success "Initramfs installed at $INITRAMFS_DEST"
else
  warn "No initramfs was produced at $INITRAMFS_DEST, kernel may not boot without one."
fi

step "Updating bootloader"

# Limine detection/update
LIMINE_UPDATED=false
if [[ -f /boot/limine.conf ]]; then
  LIMINE_CFG="/boot/limine.conf"
  cp "$LIMINE_CFG" "${LIMINE_CFG}.bak"
  info "Backed up to ${LIMINE_CFG}.bak"

  # On Haliade system /boot/limine.conf belongs to chronos: it regenerates the whole
  # file and stamps it "do not hand-edit". chronos picks the newest vmlinuz-*
  # in /boot, strips the prefix for the version, and then looks for
  # /boot/initramfs-<that version>.img, exactly the pair installed above, so
  # letting it do the work keeps the two from disagreeing. It also writes
  # through a temp file, so a failure leaves the old config intact and editing
  # in place stays a safe fallback.
  if command -v chronos &>/dev/null; then
    if chronos rewrite-limine 2>&1 | tee -a "$LOG_FILE"; then
      success "Limine config regenerated by chronos for kernel $NEW_VERSION."
      LIMINE_UPDATED=true
    else
      warn "chronos rewrite-limine failed: editing $LIMINE_CFG in place instead."
    fi
  fi

  if ! $LIMINE_UPDATED; then
    info "Detected Limine bootloader, updating $LIMINE_CFG..."
    # Update ONLY the default (first) entry. A config regenerated by chronos
    # has one entry per generation, each pinned to the kernel ITS snapshot
    # has modules for; rewriting every entry to the newest kernel would boot
    # older generations with a kernel whose modules are not in their root
    # (no drivers, no network). The live entry is written first, so the first
    # occurrence is the one to bump.
    sed -i "0,/kernel_path:[[:space:]]*boot():\/vmlinuz-[^ ]*/{s|kernel_path: boot():/vmlinuz-[^ ]*|kernel_path: boot():/vmlinuz-${NEW_VERSION}|}" "$LIMINE_CFG"
    sed -i "0,/module_path:[[:space:]]*boot():\/initramfs-[^ ]*\.img/{s|module_path: boot():/initramfs-[^ ]*\.img|module_path: boot():/initramfs-${NEW_VERSION}.img|}" "$LIMINE_CFG"
    success "Limine config updated for kernel $NEW_VERSION."
  fi
fi

# GRUB detection/update (fallback for non-Haliade distros)
if command -v grub-mkconfig &>/dev/null || command -v update-grub &>/dev/null; then
  GRUB_CMD=""
  if command -v grub-mkconfig &>/dev/null; then
    GRUB_CMD="grub-mkconfig"
  elif command -v update-grub &>/dev/null; then
    GRUB_CMD="update-grub"
  fi

  GRUB_CFG=""
  for p in /boot/grub/grub.cfg /boot/efi/EFI/GRUB/grub.cfg; do
    [[ -f "$p" ]] && { GRUB_CFG="$p"; break; }
  done
  [[ -z "$GRUB_CFG" ]] && GRUB_CFG="/boot/grub/grub.cfg"

  cp "$GRUB_CFG" "${GRUB_CFG}.bak"
  info "Backed up grub.cfg to ${GRUB_CFG}.bak"

  if [[ "$GRUB_CMD" == "update-grub" ]]; then
    $GRUB_CMD 2>&1 | tee -a "$LOG_FILE" || error "update-grub failed."
  else
    $GRUB_CMD -o "$GRUB_CFG" 2>&1 | tee -a "$LOG_FILE" || error "grub-mkconfig failed."
  fi
  success "GRUB config regenerated with Linux $NEW_VERSION entry."
fi

# Kernel headers + out-of-tree module (DKMS) support for the new kernel.
# Must run BEFORE SRC_DIR/TARBALL removal below.
HEADERS_SRC="/usr/src/linux-$NEW_VERSION"

step "Preparing kernel headers at $HEADERS_SRC"
rm -rf "$HEADERS_SRC"
mkdir -p "$HEADERS_SRC" || warn "Cannot create $HEADERS_SRC: out-of-tree modules will not build for $NEW_VERSION"

if [[ -f "$BUILD_DIR/$TARBALL" && -d "$HEADERS_SRC" ]]; then
  # Fresh extract: the build tree is full of object files; DKMS only needs a
  # *prepared* source tree, which keeps /usr/src at ~source size instead of
  # several GB of .o files.
  if tar -xf "$BUILD_DIR/$TARBALL" -C "$HEADERS_SRC" --strip-components=1 \
       2>&1 | tee -a "$LOG_FILE" >/dev/null; then
    cp "$SRC_DIR/.config" "$HEADERS_SRC/.config" 2>/dev/null \
      || warn "Could not copy .config into headers tree"
    if (cd "$HEADERS_SRC" \
        && make olddefconfig >/dev/null 2>&1 \
        && make modules_prepare 2>&1 | tee -a "$LOG_FILE" >/dev/null); then
      success "Kernel headers prepared at $HEADERS_SRC"

      # modules_install left /lib/modules/<ver>/build pointing into the
      # temporary build dir that is about to be deleted: repoint it or
      # every future DKMS/out-of-tree build gets a dangling symlink.
      if [[ -d "/lib/modules/$NEW_VERSION" ]]; then
        ln -sfn "$HEADERS_SRC" "/lib/modules/$NEW_VERSION/build"
        success "build symlink now -> /lib/modules/$NEW_VERSION/build -> $HEADERS_SRC"
      fi

      # Rebuild registered DKMS packages (nvidia open/closed, vbox, ...) for
      # the new kernel. Non-fatal: the kernel itself works without them, and
      # a missing toolchain (gcc/dkms via zeta) should not fail the build.
      if command -v dkms &>/dev/null; then
        step "Rebuilding DKMS modules for $NEW_VERSION"
        if dkms autoinstall -k "$NEW_VERSION" 2>&1 | tee -a "$LOG_FILE"; then
          success "DKMS modules built for $NEW_VERSION"
        else
          warn "dkms autoinstall reported errors: check $LOG_FILE (install gcc/dkms via zeta if missing)"
        fi
      else
        info "dkms not installed, skipping out-of-tree module rebuild"
      fi
    else
      warn "modules_prepare failed: out-of-tree modules will not build for $NEW_VERSION"
    fi
  else
    warn "Could not extract $BUILD_DIR/$TARBALL for headers: skipping DKMS support"
  fi
fi

# Snapshot this exact state (new kernel + rebuilt DKMS modules) as a fresh
# btrfs generation via chronos, so the new kernel gets its own boot entry.
# chronos pins each generation to the kernel ITS snapshot has modules for,
# so existing generations keep the kernel they were captured with; this new
# one is the upgrade. Optional: on systems without the btrfs @/@snapshots
# layout (e.g. the live ISO) the call fails here: warn, the kernel itself
# is already installed and bootable.
if command -v chronos &>/dev/null; then
  step "Creating btrfs generation with kernel $NEW_VERSION"
  if chronos create "kernel $NEW_VERSION" 2>&1 | tee -a "$LOG_FILE"; then
    success "Generation created with kernel $NEW_VERSION (limine.conf updated)."
  else
    warn "chronos create failed: no new generation (not a chronos/btrfs system?)."
  fi
fi

step "Cleaning up"
cd "$BUILD_DIR" 2>/dev/null || true
rm -rf "$SRC_DIR" 2>/dev/null || warn "Could not remove $SRC_DIR"
rm -f "$BUILD_DIR/$TARBALL" 2>/dev/null || true
if $SIGNED; then
  rm -f "$BUILD_DIR/$SIGNATURE" 2>/dev/null || true
fi

echo ""
echo -e "${GREEN}${BOLD}╔══════════════════════════════════════════════════════╗${RESET}"
echo -e "${GREEN}${BOLD}║  Kernel $NEW_VERSION generated successfully.         ║${RESET}"
echo -e "${GREEN}${BOLD}╠══════════════════════════════════════════════════════╣${RESET}"
echo -e "${GREEN}${BOLD}║  You can now reboot to use this kernel.              ║${RESET}"
echo -e "${GREEN}${BOLD}╚══════════════════════════════════════════════════════╝${RESET}"
echo ""
info "logs have been saved to $LOG_FILE"
